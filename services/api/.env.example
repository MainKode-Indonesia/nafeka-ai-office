APP_NAME=Nafeka AI Office API
APP_VERSION=0.2.0
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://nafeka:CHANGE_ME@127.0.0.1:5432/nafeka_ai_office

# Generate a unique secret with at least 32 characters.
JWT_SECRET_KEY=CHANGE_ME_generate_a_unique_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000

# Login rate limiting.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
